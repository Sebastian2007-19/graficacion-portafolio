function setup() {
  createCanvas(800, 500);
  noStroke();
}

function draw() {
  // Fondo del cielo
  background("#172A52");

  // Luna
  fill("#F5D76E");
  ellipse(730, 100, 80, 80);

  // Estrellas
  fill("#F9E79F");
  ellipse(100, 90, 25, 25);
  ellipse(200, 150, 18, 18);
  ellipse(300, 80, 22, 22);
  ellipse(430, 130, 20, 20);
  ellipse(550, 70, 25, 25);

  // Remolinos del cielo
  noFill();
  stroke("#E8C547");
  strokeWeight(8);

  ellipse(300, 200, 220, 100);
  ellipse(350, 230, 260, 120);
  ellipse(450, 200, 180, 90);

  // Montañas
  noStroke();
  fill("#263B63");
  triangle(100, 700, 100, 100, 100, 300);
  triangle(250, 400, 550, 270, 650, 400);
  triangle(500, 400, 700, 240, 800, 400);

  // Pueblo
  fill("#D9B44A");
  rect(0, 400, 800, 400);

  // Casas
  fill("#6E4A3A");
  rect(80, 410, 100, 100);
  rect(220, 420, 90, 90);
  rect(350, 400, 120, 110);
  rect(520, 420, 100, 90);

  // Techos
  fill("#3D2930");
  triangle(60, 410, 130, 350, 200, 410);
  triangle(205, 420, 265, 370, 325, 420);
  triangle(335, 400, 410, 340, 485, 400);
  triangle(505, 420, 570, 365, 635, 420);

  // Ventanas
  fill("#F4D35E");
  rect(105, 440, 20, 25);
  rect(145, 440, 20, 25);
  rect(245, 445, 20, 20);
  rect(385, 430, 20, 25);
  rect(430, 430, 20, 25);

  // Ciprés
  fill("#182E2A");
  triangle(650, 600, 700, 250, 760, 600);
  text("X: " + floor(mouseX) + "  Y: " + floor(mouseY), 20, 30);
}
