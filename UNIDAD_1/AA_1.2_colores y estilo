function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(179, 255, 153);
  

  fill (255, 153, 51, 120)
  stroke (0,0,0)
  rect(100,100,200,200)
  fill(255,255,255,)
  strokeWeight (0)
  noStroke()
  ellipse (150, 160, 40, 40)
  noFill()
